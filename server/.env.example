# Template for local development. Copy to server/.env (git-ignored, see
# .gitignore) and fill in real values there:
#   cp server/.env.example server/.env
#
# For production, use server/.env.production.example instead — that one is
# loaded via docker-compose.prod.yml's env_file, not by this server/.env.

# Required. The server refuses to start without this (see
# middleware/authMiddleware.js) — there is no fallback secret.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Optional. Token lifetime, e.g. 30d, 7d, 12h. Defaults to 30d if unset.
JWT_EXPIRES_IN=30d

# Optional. Defaults to mongodb://localhost:27017/userDB — point this at a
# local MongoDB instance (e.g. `brew services start mongodb-community`, or
# `docker run -p 27017:27017 mongo`) if you don't already have one running.
MONGODB_URI=mongodb://localhost:27017/userDB

# Optional. Defaults to 3000. The mobile app's default dev API URL
# (src/core/config.ts in Quiz Master Mobile App) assumes this default.
PORT=3000

# Optional. Comma-separated list of allowed browser origins for CORS. Leave
# unset to keep the API same-origin only (native mobile fetch isn't affected
# either way — this only matters for browser-based clients, e.g. the Angular
# web app running on its own dev server).
# CORS_ORIGINS=http://localhost:4200
