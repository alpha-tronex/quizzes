# Template only — copy to server/.env.production ON THE SERVER and fill in
# real values there. server/.env.production is git-ignored and must never
# be committed (matches the FAIS repo's server/.env.production pattern).
#
# Loaded into the quizmaster-app container via `env_file` in
# docker-compose.prod.yml. MONGODB_URI, PORT, and NODE_ENV are set directly
# in docker-compose.prod.yml (not secrets) — only put actual secrets here.

# Required. Generate with: openssl rand -base64 48
# There is currently a hardcoded fallback in server/middleware/authMiddleware.js
# if this is unset — always set it explicitly in production.
JWT_SECRET=

# Optional — only needed if/when features that use these are enabled.
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
