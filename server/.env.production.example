# Template only — copy to server/.env.production ON THE SERVER and fill in
# real values there. server/.env.production is git-ignored and must never
# be committed (matches the FAIS repo's server/.env.production pattern).
#
# Loaded into the quizmaster-app container via `env_file` in
# docker-compose.prod.yml. MONGODB_URI, PORT, and NODE_ENV are set directly
# in docker-compose.prod.yml (not secrets) — only put actual secrets here.

# Required. Generate with: openssl rand -base64 48
# The server fails to start if this is unset — there is no fallback secret.
JWT_SECRET=

# Optional. Token lifetime, e.g. 30d, 7d, 12h. Defaults to 30d if unset.
JWT_EXPIRES_IN=30d

# Optional. Comma-separated list of allowed browser origins for CORS. Leave
# unset to keep the API same-origin only (native mobile fetch isn't affected
# either way — this only matters for browser-based clients).
# CORS_ORIGINS=https://quizmaster.alphatronex.com

# Optional — only needed if/when features that use these are enabled.
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
