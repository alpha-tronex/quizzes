# Environment Configuration
# Copy this file to .env and update with your values

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/userDB

# Server Configuration
PORT=3000
NODE_ENV=production

# Required. The server refuses to start without this set — no fallback.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Optional. Token lifetime, e.g. 30d, 7d, 12h. Defaults to 30d if unset.
JWT_EXPIRES_IN=30d

# Optional. Comma-separated list of allowed browser origins for CORS, e.g.
# the Expo web dev server used when testing the mobile app in a browser.
# Native mobile fetch (iOS/Android) is not subject to CORS and doesn't need
# this. Leave unset to keep the API same-origin only.
# CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Optional: MongoDB Atlas Connection (for cloud deployment)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/userDB?retryWrites=true&w=majority
